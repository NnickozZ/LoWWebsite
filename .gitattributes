# Normalise line endings: LF in the repository, native in the working tree.
* text=auto

# These are read by Linux tools that will not tolerate CRLF — a shell script
# with Windows line endings fails on the VPS with "bad interpreter: no such
# file or directory", which is a genuinely baffling error to debug.
*.sh    text eol=lf
*.mjs   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf

# Never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.zip binary
